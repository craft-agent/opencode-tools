{
  "name": "opencode-tools",
  "version": "0.0.0",
  "description": "OpenCode tools for coding agents: start, follow, steer and answer sessions from another harness.",
  "author": {
    "name": "craftsamo",
    "url": "https://github.com/craft-agent"
  },
  "homepage": "https://github.com/craft-agent/opencode-tools#readme",
  "repository": "https://github.com/craft-agent/opencode-tools",
  "license": "LicenseRef-AGPL-3.0-Commons-Clause",
  "skills": "./skills",
  "mcpServers": {
    "opencode-tools": {
      "command": "node",
      "args": ["dist/mcp.js"],
      "cwd": ".",
      "default_tools_approval_mode": "writes",
      "env_vars": [
        "OPENCODE_TOOLS_TOOLSETS",
        "OPENCODE_TOOLS_READ_ONLY",
        "OPENCODE_TOOLS_TOOLS",
        "OPENCODE_TOOLS_EXCLUDE_TOOLS",
        "OPENCODE_TOOLS_CONFIRM",
        "OPENCODE_TOOLS_UNATTENDED",
        "OPENCODE_TOOLS_GRANTS_DIR",
        "OPENCODE_TOOLS_CALLER",
        "OPENCODE_TOOLS_ROLES",
        "OPENCODE_TOOLS_GRANT_KEY",
        "PATH",
        "HOME",
        "USER",
        "LOGNAME",
        "SHELL",
        "LANG",
        "LANGUAGE",
        "LC_ALL",
        "LC_CTYPE",
        "LC_MESSAGES",
        "TERM",
        "TMPDIR",
        "TZ",
        "XDG_CONFIG_HOME",
        "XDG_DATA_HOME",
        "XDG_STATE_HOME",
        "XDG_CACHE_HOME",
        "XDG_RUNTIME_DIR"
      ]
    }
  }
}
